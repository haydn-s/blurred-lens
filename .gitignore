# Secrets
.env

# Python
.venv/
__pycache__/
.pytest_cache/

# Generated (large; rebuild with the pipeline -- see README)
outputs/

# web/data/ is generated too, but it is what GitHub Pages serves, so the part the site reads is
# committed: rebuilding it needs the images in outputs/, which no clone and no CI run will have.
# Left out are the export's own cache (sources.json records local paths and mtimes, so it is stale
# the moment anyone else checks it out) and composites/, a leftover from the composite approach
# that nothing loads any more.
web/data/sources.json
web/data/composites/

# macOS
.DS_Store
deliverables/figures/
deliverables/.countries-50m.json

# Office lock files: PowerPoint and Word drop a ~$name beside any document they have open,
# and a `git add -A` while the poster is open will otherwise commit one.
~$*
