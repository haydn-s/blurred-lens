# Copy to .env and fill in. .env is gitignored -- never commit real tokens.

# Replicate API token, from https://replicate.com/account/api-tokens
# The token decides which account is billed, so switch to the organization that pays
# BEFORE creating it: account menu -> the organization -> API tokens.
REPLICATE_API_TOKEN=

# Only needed if config.toml sets provider = "openai":
# OPENAI_API_KEY=
